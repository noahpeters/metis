{
  "name": "metis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "find src scripts runtime -type f -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "db:migrate:production": "node scripts/require-github-actions.mjs && wrangler d1 migrations apply DB --remote",
    "deploy:production": "node scripts/require-github-actions.mjs && wrangler deploy",
    "deploy:ui:production": "node scripts/require-github-actions.mjs && wrangler deploy --config wrangler.ui.jsonc",
    "test": "node --test test/*.test.mjs",
    "test:ui:visual": "node scripts/capture-ui.mjs",
    "test:full-stack": "node --test test/full-stack/pacing.test.mjs",
    "verify": "npm run check && npm test",
    "deploy:repository:production": "node scripts/require-github-actions.mjs && wrangler deploy --config wrangler.repository.jsonc",
    "deploy:codex:production": "node scripts/require-github-actions.mjs && wrangler deploy --config wrangler.codex.jsonc"
  },
  "devDependencies": {
    "miniflare": "5.20260828.0-alpha",
    "playwright": "^1.62.1",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  }
}
